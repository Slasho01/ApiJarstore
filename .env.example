# Copia este archivo a .env y ajusta los valores
DATABASE_URL=postgres://usuario:password@localhost/jarstoreapi
# Clave para firmar los JWT (mínimo 32 caracteres). Genera una con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_TTL_SECONDS=7200
HOST=127.0.0.1
PORT=8080
# Orígenes permitidos para CORS, separados por coma (vacío = cualquier origen, sólo para desarrollo)
CORS_ORIGINS=http://localhost:3000
DB_POOL_SIZE=10
RUST_LOG=info

# URL pública del frontend (enlaces en los correos: recuperar contraseña, ver pedido)
FRONTEND_URL=http://localhost:5173

# ---- Correo (SMTP) ----
# Sin SMTP_HOST, los correos se escriben en el log de la API (modo desarrollo).
# Para enviarlos de verdad, descomenta y completa:
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (587) | tls (465) | none (sólo pruebas locales)
# SMTP_USER=usuario
# SMTP_PASSWORD=contraseña
# SMTP_FROM=JarStore <no-reply@tudominio.cl>

# ---- Sitio público y SEO ----
# URL pública de la tienda (canonical, sitemap, Open Graph). En producción: https://tudominio.cl
PUBLIC_URL=http://localhost:8080
# Carpeta del frontend compilado (npm run build). Si se define, la API sirve la tienda
# completa e inserta los metadatos SEO en cada página. Por defecto busca ../Frontend/dist
# FRONTEND_DIST=../Frontend/dist

# ---- Imágenes ----
# Por defecto se guardan en el servidor (WebP en 4 tamaños) y se sirven en /uploads
UPLOAD_DIR=uploads
# Para usar Cloudinary (WebP/AVIF automáticos), descomenta con tus datos de cloudinary.com > Settings > API Keys:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=jarstore

# ---- Mercado Pago (Chile) ----
# Credenciales en https://www.mercadopago.cl/developers/panel/app (usa primero las de prueba: TEST-...)
# MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (panel > Webhooks > "Clave secreta"). Recomendada.
# MP_WEBHOOK_SECRET=xxxxxxxx
# URL pública https de esta API, para recibir el webhook (en desarrollo puedes usar ngrok)
# API_PUBLIC_URL=https://tudominio.cl
